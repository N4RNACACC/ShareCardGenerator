<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShareCardGenerator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ShareCardGenerator.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ShareCardGenerator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ShareCardGenerator">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="10*,*">
        <Grid Grid.Row="0" ColumnDefinitions="* , 5 , 3*">
            <Border Grid.Column="0"
                    CornerRadius="0 10 10 0"
                    BorderBrush="Black"
                    BorderThickness="1">
                <Grid RowDefinitions="* , 0.5* ,0.5* ,0.5* , 0.5* , 0.5* , * ">
                    <TextBox Grid.Row="0"
                             Text="{Binding SourceUrl}"
                             PlaceholderText="Source URL"
                             TextWrapping="Wrap"
                             Margin="0 0 0 5"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SongTitle}"
                             PlaceholderText="Song Title"
                             TextWrapping="Wrap"
                             Margin="0 5 0 5"/>
                    <TextBox Grid.Row="2"
                             Text="{Binding ArtistName}"
                             PlaceholderText="Artist Name"
                             TextWrapping="Wrap"
                             Margin="0 5 0 5"/>
                    <TextBox Grid.Row="3"
                             Text="{Binding AlbumName}"
                             PlaceholderText="Album Title"
                             TextWrapping="Wrap"
                             Margin="0 5 0 5"/>
                    <TextBox Grid.Row="4"
                             Text="{Binding SongStyle}"
                             PlaceholderText="Song Style"
                             TextWrapping="Wrap"
                             Margin="0 5 0 5"/>
                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                Margin="0 5 0 5">
                        <TextBox Text="{Binding BackgroundImageID}"
                                 PlaceholderText="BackgroundPID"
                                 Width="135"
                                 Margin="0 0 2 0"/>
                        <TextBox Text="{Binding IDNumber}"
                                 PlaceholderText="Num"
                                 Margin="2 0 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2">
                <Grid RowDefinitions="30 , *">
                    <Border Grid.Row="0"
                            CornerRadius="10 0 0 10"
                            BorderBrush="Black"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*, 8*">
                            <TextBlock Grid.Column="0"
                                       Text="Preview"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="5"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InfoBar}"
                                       Margin="5"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            CornerRadius="10 0 0 10"
                            BorderBrush="Black"
                            BorderThickness="1">
                        <Border BorderBrush="Black"
                                BorderThickness="1"
                                Margin="10 100 10 100">
                            <views:ShareCardView x:Name="ShareCardView"
                                                 DataContext="{Binding}"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1">
            <Border Margin="10">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Single Img Mode"
                              IsChecked="{Binding SingleImgMode}"/>
                    <Button Content="Generate Card"
                            Command="{Binding GenerateCommand}"/>
                    <Button Content="Save Card"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Clean Cache"
                            Command="{Binding CleanCacheCommand}"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</Window>
